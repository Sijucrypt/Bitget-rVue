# Bitget rVue environment
# Copy to .env and fill in. .env is gitignored. Every value below is optional
# except QWEN_API_KEY, which is required for the research brief.
#
# Nothing here is fabricated by the app: if the model is unconfigured,
# GET/POST /api/research returns 503 model_not_configured together with the
# deterministic Evidence Package instead of inventing a brief.
#
# Loading: Next.js reads .env automatically for API routes. The tsx scripts do
# not, so lib/env.ts loads it for them - it only fills variables that are not
# already set, so it never overrides a real environment.
# After editing .env, restart `npm run dev`; Next does not hot-reload it.
#
# Verify credentials in isolation before blaming the pipeline:
#     npm run check:model

# --- AI reasoning (Tier 2) ---
# Bitget hackathon Qwen key (from the official Qwen Setup Guide).
QWEN_API_KEY=
# DASHSCOPE_API_KEY= is accepted as an alternative to QWEN_API_KEY.

# OpenAI-compatible base URL. Default is the official Bitget hackathon
# endpoint; the /v1 suffix is required. Point at DashScope compatible mode
# only if you use a DashScope key instead.
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model id issued for the hackathon key.
QWEN_MODEL=qwen3.8-max
QWEN_TEMPERATURE=0.2
QWEN_MAX_TOKENS=2200
QWEN_TIMEOUT_MS=300000
# Set to 0 if the endpoint rejects response_format: { type: "json_object" }.
QWEN_RESPONSE_FORMAT=1

# --- Evidence collectors ---
# Window used for both news and on-chain activity.
RESEARCH_WINDOW_HOURS=48
# Set either to 0 to skip that collector. Skipped collectors report status
# PENDING and appear in the package gaps; they are never silently zero-filled.
NEWS_ENABLED=1
ONCHAIN_ENABLED=1